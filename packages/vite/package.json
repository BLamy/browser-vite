{
  "name": "browser-vite",
  "version": "6.0.0-browser.1",
  "license": "MIT",
  "author": "Evan You",
  "description": "Native-ESM powered web dev build tool - Browser Edition",
  "bin": {
    "vite": "bin/vite.js"
  },
  "main": "dist/node/index.js",
  "browser": "dist/browser/index.js",
  "types": "dist/node/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "client.d.ts",
    "src/client",
    "types"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitejs/vite.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/vitejs/vite/issues"
  },
  "homepage": "https://github.com/vitejs/vite/tree/main/#readme",
  "scripts": {
    "dev": "rimraf dist && rollup -c -w",
    "build": "rimraf dist && npm run lint && run-s build-bundle build-types",
    "build-bundle": "rollup -c",
    "build-types": "run-s build-browser-types build-temp-types patch-types roll-types",
    "build-temp-types": "tsc --emitDeclarationOnly --outDir temp/node -p src/node",
    "build-browser-types": "tsc --emitDeclarationOnly --outDir temp -p src/browser",
    "ci-build": "rimraf dist && run-s build-bundle build-types",
    "patch-types": "node scripts/patchTypes.cjs",
    "roll-types": "cp -R temp/* dist/ && rimraf temp",
    "lint": "eslint --ext .ts src/**",
    "format": "prettier --write --parser typescript \"src/**/*.ts\"",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path .",
    "release": "node ../../scripts/release.cjs"
  },
  "//": "READ CONTRIBUTING.md to understand what to put under deps vs. devDeps!",
  "optionalDependencies": {
    "fsevents": "~2.3.2"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "postcss": "^8.5.0",
    "resolve": "^1.22.8",
    "rollup": "^4.28.0",
    "@ampproject/remapping": "^2.3.0",
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-dynamic-import-vars": "^2.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@rollup/pluginutils": "^5.1.0",
    "@vue/compiler-dom": "^3.5.0",
    "acorn": "^8.14.0",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "cjs-module-lexer": "^1.4.0",
    "clean-css": "^5.3.3",
    "compression": "^1.7.4",
    "connect": "^3.7.0",
    "connect-history-api-fallback": "^2.0.0",
    "convert-source-map": "^2.0.0",
    "cors": "^2.8.5",
    "debug": "^4.3.7",
    "dotenv": "^16.4.0",
    "dotenv-expand": "^12.0.0",
    "es-module-lexer": "^1.5.0",
    "estree-walker": "^2.0.2",
    "etag": "^1.8.1",
    "execa": "^5.1.1",
    "http-proxy": "^1.18.1",
    "launch-editor-middleware": "^2.9.0",
    "magic-string": "^0.30.0",
    "micromatch": "^4.0.8",
    "mime": "^3.0.0",
    "open": "^8.4.2",
    "periscopic": "^3.1.0",
    "picocolors": "^1.1.0",
    "postcss-import": "^16.1.0",
    "postcss-load-config": "^4.0.2",
    "postcss-modules": "^6.0.0",
    "resolve.exports": "^2.0.2",
    "rollup-plugin-license": "^3.5.0",
    "selfsigned": "^2.4.1",
    "sirv": "^2.0.4",
    "source-map-support": "^0.5.21",
    "strip-ansi": "^6.0.1",
    "terser": "^5.36.0",
    "tinyglobby": "^0.2.0",
    "tsconfck": "^3.1.0",
    "tslib": "^2.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/convert-source-map": "^2.0.3",
    "@types/debug": "^4.1.12",
    "@types/estree": "^1.0.6",
    "@types/etag": "^1.8.3",
    "@types/less": "^3.0.6",
    "@types/micromatch": "^4.0.9",
    "@types/mime": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/resolve": "^1.20.6",
    "@types/sass": "^1.45.0",
    "@types/stylus": "^0.48.43",
    "@types/ws": "^8.5.13"
  },
  "peerDependencies": {
    "less": "*",
    "sass": "*",
    "stylus": "*"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "stylus": {
      "optional": true
    },
    "less": {
      "optional": true
    }
  }
}
